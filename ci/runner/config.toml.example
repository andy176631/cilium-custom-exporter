# Example gitlab-runner config for the release jobs.
#
# Copy it to the runner host as /etc/gitlab-runner/config.toml (do not commit
# the real one), or register a runner with the equivalent command:
#
#   gitlab-runner register --non-interactive \
#     --url "https://gitlab.example.com" \
#     --token "$RUNNER_AUTH_TOKEN" \
#     --executor docker \
#     --docker-image alpine:3.20
#
# The runner authentication token (glrt-...) comes from the GitLab UI:
# Settings > CI/CD > Runners > New project runner. Set the runner's tags
# there, matching `.runner.tags` in ci/release-config.yml.

concurrent = 2
check_interval = 0

[[runners]]
  name = "cilium-custom-exporter-release"
  # GitLab instance URL.
  url = "https://gitlab.example.com"
  # Runner authentication token. Fill it in on the runner host only.
  token = "glrt-REPLACE_ME"
  executor = "docker"
  [runners.docker]
    image = "alpine:3.20"
    # Kaniko does not need privileged mode.
    privileged = false
    volumes = ["/cache"]
    pull_policy = ["if-not-present"]
